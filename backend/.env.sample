# Local default. On Orizon, do NOT set PORT — the platform injects PORT=3000.
# Setting PORT=9000 in Orizon env makes the proxy hit the wrong port → Cloudflare 502.
PORT=9000
NODE_ENV=development

MONGODB_URI=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Production (Orizon) example:
# NODE_ENV=production
# CLIENT_URL=https://questbase.orzn.app
# CORS_ORIGINS=https://questbase.orzn.app
# COOKIE_SECURE=true
CLIENT_URL=http://localhost:5173
# Dashboard API only (login, projects, forms admin). Public /f/* uses per-form allowedOrigins.
# CLIENT_URL is always included automatically; list extras here if needed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5500
COOKIE_SECURE=false

BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
BREVO_SMS_SENDER=QuestBase

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FORM_RATE_LIMIT_MAX=30
OTP_RATE_LIMIT_MAX=20
OTP_SMS_RATE_LIMIT_MAX=8
BCRYPT_SALT_ROUNDS=12
